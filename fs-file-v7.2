function renderHistoryPage(){
  const history=getRichHistory();const statsBar=document.getElementById("hpStatsBar");
  const uniqueGames=new Set(history.map(h=>h.id)).size;const totalSessions=history.length;const days=new Set(history.map(h=>new Date(h.ts).toDateString())).size;
  statsBar.innerHTML=`<div class="hp-stat-card"><div class="hp-stat-n">${totalSessions}</div><div class="hp-stat-l">Sessions</div></div><div class="hp-stat-card"><div class="hp-stat-n">${uniqueGames}</div><div class="hp-stat-l">Unique Games</div></div><div class="hp-stat-card"><div class="hp-stat-n">${days}</div><div class="hp-stat-l">Days Active</div></div>`;
  const timeline=document.getElementById("hpTimeline");
  if(!history.length){timeline.innerHTML=`<div class="hp-empty"><i class="bx bx-game"></i><p>No play history yet.<br>Start playing to see your history here!</p></div>`;return;}
  const groups=groupHistoryByDay(history);timeline.innerHTML="";
  Object.entries(groups).forEach(([day,items],gi)=>{
    const group=document.createElement("div");group.className="hp-day-group";group.style.animationDelay=(gi*60)+"ms";
    const label=document.createElement("div");label.className="hp-day-label";label.textContent=formatDayLabel(day);group.appendChild(label);
    const tl=document.createElement("div");tl.className="hp-timeline";
    items.forEach(item=>{
      const g=typeof data!=="undefined"?data.find(x=>x.id===item.id):null;
      const row=document.createElement("div");row.className="hp-item";row.onclick=()=>{closeHistoryPage();if(g)openSplash(g.id);};
      let thumbHtml="";if(g&&g.img){thumbHtml=`<img class="hp-item-thumb" src="${esc(g.img)}" alt="${esc(g.name)}" loading="lazy" onerror="this.style.display='none'">`;}else{thumbHtml=`<div class="hp-item-thumb-fb"><i class="bx bx-joystick"></i></div>`;}
      const playBtn=document.createElement("button");playBtn.className="hp-item-play";playBtn.innerHTML=`<i class="bx bx-play"></i> Play`;playBtn.onclick=e=>{e.stopPropagation();closeHistoryPage();if(g)playGame(g.id);};
      row.innerHTML=thumbHtml+`<div class="hp-item-info"><div class="hp-item-name">${esc(g?g.name:item.id)}</div><div class="hp-item-meta"><span class="hp-item-time-chip"><i class="bx bx-time" style="font-size:11px"></i>${esc(formatTime(item.ts))}</span>${g?`<span style="color:var(--muted)">${esc(g.genre.split(" / ")[0])}</span>`:""}</div></div>`;
      row.appendChild(playBtn);tl.appendChild(row);
    });
    group.appendChild(tl);timeline.appendChild(group);
  });
