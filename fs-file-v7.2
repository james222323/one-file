.gotd{margin:0 25px 27.5px;border-radius:var(--r);overflow:hidden;position:relative;cursor:pointer;box-shadow:var(--sh-md);min-height:212.5px;display:flex;align-items:flex-end;transition:transform .25s var(--ease),box-shadow .25s var(--ease)}
