function renderBadges(earnedList){
  if(!earnedList)earnedList=checkAchievements(true);const grid=document.getElementById("ppBadgesGrid");if(!grid)return;grid.innerHTML="";const earned=new Set(earnedList);
  const sorted=[...ACHIEVEMENTS.filter(a=>earned.has(a.id)),...ACHIEVEMENTS.filter(a=>!earned.has(a.id))];
  sorted.forEach(a=>{
    const isEarned=earned.has(a.id);const wrap=document.createElement("div");wrap.className="pp-badge";wrap.style.cursor="default";
    const imgWrap=document.createElement("div");imgWrap.className="pp-badge-img-wrap "+(isEarned?"earned":"locked");const ico=document.createElement("i");ico.className="bx "+a.icon;ico.style.cssText=`font-size:22px;color:${isEarned?a.color:"var(--muted)"}`;imgWrap.appendChild(ico);
    if(isEarned){imgWrap.style.borderColor=a.color;imgWrap.style.boxShadow=`0 0 0 3px ${a.color}33`;imgWrap.style.background=`${a.color}18`;}
    const name=document.createElement("div");name.className="pp-badge-name "+(isEarned?"earned":"");name.textContent=a.name;if(isEarned)name.style.color=a.color;
    wrap.appendChild(imgWrap);wrap.appendChild(name);
