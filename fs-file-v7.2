<script>
// ─── TEXT SANITIZER ───────────────────────────────────────────────────────────
function esc(str){return String(str||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");}

// ─── VERIFIED BADGE ──────────────────────────────────────────────────────────
const VERIFIED_SUFFIX="_verifiedtrue";
function isVerified(handle){return typeof handle==="string"&&handle.endsWith(VERIFIED_SUFFIX);}
function displayHandle(handle){return(handle||"").replace(VERIFIED_SUFFIX,"");}
const VERIFIED_SVG=`<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:inline-block;vertical-align:middle;margin-left:4px;flex-shrink:0" title="Verified Owner"><circle cx="8" cy="8" r="8" fill="#695CFE"/><path d="M5 8.2L7 10.4L11 6" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

// ═══════════════════════════════════════════════════════════════════════════════
//  SETTINGS SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════
const SETTINGS_KEY="fusionSettings";
const ST_DEFAULTS={darkMode:true,compactGrid:false,animations:true,autoplay:true,autoFs:false,confirmExit:false,sessionTimeout:0,toastsEnabled:true,achievementToasts:true,xpToasts:true,favToasts:true,toastDuration:2600,toastPos:"bottom-right",saveHistory:true,trackPlaytime:true,trackXp:true};
function getSettings(){try{return Object.assign({},ST_DEFAULTS,JSON.parse(localStorage.getItem(SETTINGS_KEY)||"{}"));}catch{return Object.assign({},ST_DEFAULTS);}}
function saveSettingsData(obj){localStorage.setItem(SETTINGS_KEY,JSON.stringify(obj));}
function openSettings(){populateSettingsUI();document.getElementById("settingsOv").classList.add("open");stMarkClean();}
function closeSettings(){document.getElementById("settingsOv").classList.remove("open");}
function switchStTab(tab){
  ["appearance","gameplay","notifs","privacy","more"].forEach(t=>{
    document.getElementById("stPane-"+t).classList.toggle("active",t===tab);
    document.getElementById("stTab-"+t).classList.toggle("active",t===tab);
  });
