.rc-badge{display:inline-flex;align-items:center;gap:3.8px;background:var(--accent-light);color:var(--accent);font-size:10px;font-weight:800;padding:2.5px 7.5px;border-radius:123.8px;width:fit-content;margin-bottom:1.3px}
.rc-name{font-size:16.3px;font-weight:800;color:var(--text);line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.rc-genre{font-size:11.3px;font-weight:700;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
