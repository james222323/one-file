function buildCategoryTabs(){
  const wrap=document.getElementById("catTabsWrap");wrap.innerHTML="";
  const gc={};data.forEach(g=>g.genre.split(" / ").forEach(genre=>{genre=genre.trim();gc[genre]=(gc[genre]||0)+1;}));
  [{key:"all",label:"All",icon:"bx-grid-alt",count:data.length},{key:"fav",label:"Favorites",icon:"bxs-heart",count:getFavs().length},{key:"new",label:"New",icon:"bx-star",count:data.filter(g=>g.new).length},{key:"hot",label:"Hot",icon:"bx-trending-up",count:data.filter(g=>g.hot).length}].filter(t=>t.count>0||t.key==="all").forEach(t=>wrap.appendChild(makeTab(t.key,t.label,t.icon,t.count)));
