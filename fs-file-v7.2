.gotd-grad{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.92) 0%,rgba(0,0,0,.3) 50%,transparent 100%)}
.gotd-crown{position:absolute;top:13.8px;left:13.8px;background:linear-gradient(135deg,#f59e0b,#f97316);color:#fff;font-size:11.3px;font-weight:800;padding:3.8px 11.3px;border-radius:123.8px;display:flex;align-items:center;gap:5px}
.gotd-date{position:absolute;top:13.8px;right:13.8px;background:rgba(0,0,0,.38);backdrop-filter:blur(7.5px);color:#fff;font-size:11.3px;font-weight:700;padding:3.8px 11.3px;border-radius:123.8px}
.gotd-body{position:relative;padding:17.5px;display:flex;align-items:flex-end;justify-content:space-between;gap:12.5px;width:100%}
.gotd-info{flex:1;min-width:0}
.gotd-name{font-family:'Rajdhani',sans-serif;font-size:27.5px;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.1}
.gotd-genre{font-size:12.5px;font-weight:700;color:rgba(255,255,255,.7);margin-top:3.8px}
.gotd-desc{font-size:13.8px;font-weight:600;color:rgba(255,255,255,.75);margin-top:3.8px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.gotd-play{flex-shrink:0;height:45px;padding:0 20px;background:linear-gradient(135deg,#f59e0b,#f97316);color:#fff;border:none;border-radius:var(--r-sm);font-size:15px;font-weight:800;cursor:pointer;display:flex;align-items:center;gap:6.3px;font-family:inherit;transition:opacity .2s,transform .18s,box-shadow .18s;white-space:nowrap}
.gotd-play:hover{opacity:1;transform:scale(1.06);box-shadow:0 6px 20px rgba(249,115,22,.4)}
#gamepage{display:none}
.gp-banner{margin:11.3px 25px;border-radius:var(--r-sm);padding:11.3px 15px;color:#fff;font-size:13.8px;font-weight:700;display:none}
.gp-banner.show{display:block}
.gp-banner-t{font-size:15px;font-weight:800;margin-bottom:1.3px}
.gp-hdr{padding:15px 25px 8.8px;display:flex;align-items:flex-start;justify-content:space-between;gap:10px}
.gp-title{font-family:'Rajdhani',sans-serif;font-size:27.5px;font-weight:700;color:var(--text)}
.gp-desc{font-size:13.8px;color:var(--muted);font-weight:600;margin-top:1.3px}
.gp-ow{position:relative;flex-shrink:0}
.gp-obtn{width:40px;height:40px;background:var(--surface2);border:none;border-radius:var(--r-sm);color:var(--muted);font-size:23.8px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s,color .2s}
.gp-obtn:hover{background:var(--accent);color:#fff}
.stage{margin:0 25px;border-radius:var(--r);overflow:hidden;box-shadow:var(--sh-md);position:relative;background:#000;display:flex;flex-direction:column}
.game-iframe{display:block;width:100%;height:700px;border:none;background:#000;flex-shrink:0}
.play-cover{position:absolute;inset:0 0 56px;background:rgba(0,0,0,.55);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;z-index:5;gap:14px}
.play-big{width:80px;height:80px;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-size:34px;box-shadow:0 0 0 0 var(--accent-glow);transition:transform .2s,box-shadow .2s;animation:playGlow 2.5s ease-in-out infinite}
.play-cover:hover .play-big{transform:scale(1.1);box-shadow:0 0 0 20px transparent;animation:none}
.play-cover-hint{color:rgba(255,255,255,.6);font-size:12px;font-weight:700;letter-spacing:.8px}

.ctrl-bar{
  height:56px;
  background:linear-gradient(135deg,rgba(105,92,254,.95) 0%,rgba(91,78,230,.95) 100%);
  backdrop-filter:blur(12px) saturate(1.5);
  -webkit-backdrop-filter:blur(12px) saturate(1.5);
  border-top:1px solid rgba(255,255,255,.12);
  flex-shrink:0;display:flex;align-items:center;padding:0 14px;gap:4px;position:relative;
}
body.dark .ctrl-bar{
  background:linear-gradient(135deg,rgba(123,111,255,.92) 0%,rgba(105,92,254,.88) 100%);
}
.ctrl-logo{font-family:'Rajdhani',sans-serif;font-size:15px;font-weight:700;color:rgba(255,255,255,.95);letter-spacing:4px;padding-right:14px;border-right:1px solid rgba(255,255,255,.18);margin-right:6px;flex-shrink:0}
#ctrlPlaytime{display:flex;align-items:center;gap:5px;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);border-radius:99px;padding:3px 10px 3px 8px;font-size:11px;font-weight:800;color:rgba(255,255,255,.95);font-family:'Rajdhani',sans-serif;font-variant-numeric:tabular-nums;letter-spacing:.3px;flex-shrink:0}
.ctrl-spacer{flex:1}
.ctrl-sep{width:1px;height:22px;background:rgba(255,255,255,.18);flex-shrink:0;margin:0 4px}
.cbtn{width:36px;height:36px;background:transparent;border:none;border-radius:8px;color:rgba(255,255,255,.8);font-size:19px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .18s,color .18s,transform .12s}
.cbtn:hover{background:rgba(255,255,255,.18);color:#fff;transform:scale(1.12)}
.cbtn:active{transform:scale(.9);background:rgba(255,255,255,.25)}
.cbtn.on{color:#ffd6e0}
.cbtn.on:hover{background:rgba(244,63,94,.25)}
.ctrl-dd{position:absolute;bottom:calc(100% + 8px);right:14px;background:var(--surface);border:1.3px solid var(--border);border-radius:var(--r);box-shadow:var(--sh-md);min-width:200px;overflow:hidden;display:none;z-index:9999;animation:fadeUp .12s var(--ease) both}
.ctrl-dd.open{display:block}
.ctrl-dd button{display:flex;align-items:center;gap:10px;width:100%;padding:11px 16px;background:transparent;border:none;color:var(--text);font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;transition:background .15s}
.ctrl-dd button:hover{background:var(--accent);color:#fff}
.ctrl-keys{position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);background:var(--surface);border:1.3px solid var(--border);border-radius:var(--r);box-shadow:var(--sh-md);padding:14px 18px;min-width:200px;display:none;z-index:9998;animation:fadeUp .12s var(--ease) both}
.ctrl-keys.open{display:block}
.ctrl-keys h4{font-size:13px;font-weight:800;color:var(--text);margin-bottom:6px}
.ctrl-keys p{font-size:12px;font-weight:700;color:var(--muted);white-space:pre-line;line-height:1.7}
body.fs .stage{position:fixed;inset:0;z-index:2000;margin:0;border-radius:0}
body.fs .game-iframe{height:0;flex:1}
body.fs #fs-exit{display:flex}
#fs-exit{position:fixed;top:14px;left:14px;z-index:2100;width:36px;height:36px;background:rgba(0,0,0,.5);backdrop-filter:blur(8px);border:none;color:#fff;font-size:20px;border-radius:50%;cursor:pointer;display:none;align-items:center;justify-content:center;transition:background .2s,transform .15s}
#fs-exit:hover{background:rgba(200,0,0,.7);transform:scale(1.1)}
#rpPanel{position:fixed;inset:0;z-index:3000;background:var(--surface);overflow-y:auto;display:none}
#rpPanel.open{display:block}
.rp-in{max-width:550px;margin:0 auto;padding:40px 25px}
.rp-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:27.5px}
.rp-title{font-family:'Rajdhani',sans-serif;font-size:27.5px;font-weight:700;color:var(--text)}
.rp-close-btn{width:37.5px;height:37.5px;background:var(--surface2);border:none;border-radius:var(--r-sm);color:var(--muted);font-size:21.3px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s,color .2s}
.rp-close-btn:hover{background:var(--accent);color:#fff}
.rp form label{display:block;font-size:11.3px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase;color:var(--accent);margin-bottom:6.3px}
.rp form input{display:block;width:100%;height:50px;background:var(--surface2);border:1.9px solid transparent;border-radius:var(--r-sm);padding:0 13.8px;font-size:15px;font-weight:600;color:var(--text);outline:none;font-family:inherit;margin-bottom:17.5px;transition:border-color .2s}
.rp form input:focus{border-color:var(--accent)}
.rp form input::placeholder{color:var(--muted)}
.rp form button{height:50px;padding:0 30px;background:var(--accent);color:#fff;border:none;border-radius:var(--r-sm);font-size:15px;font-weight:800;cursor:pointer;font-family:inherit;transition:opacity .2s}
.rp form button:hover{opacity:.85}
.footer{padding:22.5px 25px;margin-top:17.5px;border-top:1.3px solid var(--border);font-size:12.5px;font-weight:700;color:var(--muted);text-align:center;line-height:1.8}

#settingsOv{position:fixed;inset:0;z-index:2200;display:none;align-items:flex-start;justify-content:flex-end;padding:75px 17.5px 17.5px;pointer-events:none}
#settingsOv.open{display:flex}
.st-bg{position:fixed;inset:0;background:rgba(0,0,0,.32);backdrop-filter:blur(5px);pointer-events:auto;animation:ppBgIn .2s var(--ease)}
.st-panel{position:relative;z-index:1;width:390px;max-height:calc(100vh - 95px);background:var(--surface);border:1.3px solid var(--border);border-radius:20px;box-shadow:var(--sh-lg);display:flex;flex-direction:column;pointer-events:auto;overflow:hidden;animation:ppIn .22s var(--ease) both}
.st-panel[data-settings-panel]{pointer-events:auto}
.st-hdr{padding:18px 20px 14px;border-bottom:1.3px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.st-hdr-left{display:flex;align-items:center;gap:10px}
.st-hdr-icon{width:34px;height:34px;border-radius:9px;background:var(--accent-light);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:19px}
.st-hdr-title{font-family:'Rajdhani',sans-serif;font-size:20px;font-weight:700;color:var(--text)}
.st-close{width:30px;height:30px;border-radius:50%;background:var(--surface2);border:none;color:var(--muted);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s,color .2s}
.st-close:hover{background:var(--accent);color:#fff}
.st-tabs{display:flex;gap:0;border-bottom:1.3px solid var(--border);padding:0 20px;flex-shrink:0}
.st-tab{flex:1;height:38px;background:transparent;border:none;border-bottom:2px solid transparent;color:var(--muted);font-size:11px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;cursor:pointer;font-family:inherit;transition:color .15s,border-color .15s;margin-bottom:-1px;display:flex;align-items:center;justify-content:center;gap:5px}
.st-tab i{font-size:15px}
.st-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
.st-tab:hover{color:var(--accent)}
.st-body{overflow-y:auto;padding:16px 20px 24px;flex:1;scrollbar-width:thin}
.st-pane{display:none;flex-direction:column;gap:20px}
.st-pane.active{display:flex}
.st-group{display:flex;flex-direction:column;gap:10px}
.st-group-label{font-size:9.5px;font-weight:800;letter-spacing:2.5px;text-transform:uppercase;color:var(--accent);padding-bottom:2px;border-bottom:1px solid var(--border)}
.st-row{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:36px}
.st-row-info{flex:1;min-width:0}
.st-row-label{font-size:13.5px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:6px}
.st-row-label i{color:var(--accent);font-size:16px;flex-shrink:0}
.st-row-sub{font-size:10.5px;font-weight:600;color:var(--muted);margin-top:2px;line-height:1.4}
.st-toggle{position:relative;width:42px;height:24px;flex-shrink:0}
.st-toggle input{opacity:0;width:0;height:0;position:absolute}
.st-toggle-track{position:absolute;inset:0;background:var(--border);border-radius:99px;cursor:pointer;transition:background .2s}
.st-toggle input:checked+.st-toggle-track{background:var(--accent)}
.st-toggle-track::after{content:'';position:absolute;top:3px;left:3px;width:18px;height:18px;background:#fff;border-radius:50%;transition:transform .2s var(--ease);box-shadow:0 1px 4px rgba(0,0,0,.2)}
.st-toggle input:checked+.st-toggle-track::after{transform:translateX(18px)}
.st-select{height:32px;padding:0 10px;background:var(--surface2);border:1.5px solid var(--border);border-radius:8px;color:var(--text);font-size:12.5px;font-weight:700;font-family:inherit;outline:none;cursor:pointer;transition:border-color .2s;flex-shrink:0;min-width:100px}
.st-select:focus{border-color:var(--accent)}
.st-slider-wrap{display:flex;align-items:center;gap:10px;flex-shrink:0;min-width:140px}
.st-slider{-webkit-appearance:none;appearance:none;height:4px;border-radius:99px;background:linear-gradient(to right,var(--accent) 0%,var(--accent) var(--pct,100%),var(--border) var(--pct,100%));outline:none;cursor:pointer;flex:1}
.st-slider::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 3px var(--accent-glow);cursor:pointer;transition:transform .15s}
.st-slider::-webkit-slider-thumb:hover{transform:scale(1.2)}
.st-slider-val{font-size:11px;font-weight:800;color:var(--accent);min-width:28px;text-align:right;font-family:'Rajdhani',sans-serif}
.st-swatches{display:flex;gap:7px;flex-wrap:wrap;margin-top:6px}
.st-swatch{width:28px;height:28px;border-radius:50%;border:none;cursor:pointer;transition:transform .15s,box-shadow .15s;position:relative;flex-shrink:0}
.st-swatch:hover{transform:scale(1.18)}
.st-swatch.active{box-shadow:0 0 0 2.5px var(--surface),0 0 0 4.5px currentColor}
.st-font-preview{padding:10px 14px;background:var(--surface2);border-radius:10px;font-weight:700;color:var(--text);border:1.3px solid var(--border);transition:font-size .2s}
.st-more-btn{display:flex;align-items:center;gap:12px;width:100%;padding:12px 14px;background:var(--surface2);border:1.3px solid var(--border);border-radius:10px;cursor:pointer;font-family:inherit;transition:background .15s,border-color .15s,transform .15s;text-align:left}
.st-more-btn:hover{background:var(--accent-light);border-color:var(--accent);transform:translateX(3px)}
.st-more-btn>i:first-child{font-size:20px;color:var(--accent);flex-shrink:0}
.st-more-btn-info{flex:1;min-width:0}
.st-more-btn-title{font-size:13.5px;font-weight:800;color:var(--text)}
.st-more-btn-sub{font-size:10.5px;font-weight:600;color:var(--muted);margin-top:1px}
.st-more-chevron{font-size:18px;color:var(--muted);flex-shrink:0}
.st-data-row{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--surface2);border-radius:10px;border:1.3px solid var(--border)}
.st-data-row i{color:var(--accent);font-size:20px;flex-shrink:0}
.st-data-row-info{flex:1;min-width:0}
.st-data-row-title{font-size:12.5px;font-weight:800;color:var(--text)}
.st-data-row-sub{font-size:10px;font-weight:600;color:var(--muted);margin-top:1px}
.st-data-btn{height:30px;padding:0 12px;border:none;border-radius:8px;font-size:11.5px;font-weight:800;cursor:pointer;font-family:inherit;transition:background .2s,color .2s;flex-shrink:0}
.st-data-btn.danger{background:#fee2e2;color:#dc2626}
.st-data-btn.danger:hover{background:#dc2626;color:#fff}
.st-data-btn.neutral{background:var(--accent-light);color:var(--accent)}
.st-data-btn.neutral:hover{background:var(--accent);color:#fff}
.st-footer{padding:12px 20px;border-top:1.3px solid var(--border);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;gap:10px}
.st-reset{height:34px;padding:0 14px;background:var(--surface2);border:1.3px solid var(--border);border-radius:8px;color:var(--muted);font-size:12px;font-weight:800;cursor:pointer;font-family:inherit;transition:all .2s;display:flex;align-items:center;gap:5px}
.st-reset:hover{background:#fee2e2;color:#dc2626;border-color:#fca5a5}
.st-save{height:34px;padding:0 18px;background:var(--accent);border:none;border-radius:8px;color:#fff;font-size:12px;font-weight:800;cursor:pointer;font-family:inherit;transition:opacity .2s,transform .15s;display:flex;align-items:center;gap:5px}
.st-save:hover{opacity:.88;transform:scale(1.04)}
.st-unsaved-dot{width:7px;height:7px;border-radius:50%;background:#f59e0b;display:none;flex-shrink:0}
.st-unsaved-dot.show{display:block;animation:unsavedPulse 1.5s ease-in-out infinite}

#lbPage{position:fixed;inset:0;z-index:2500;background:var(--bg);overflow-y:auto;display:none;flex-direction:column}
#lbPage.open{display:flex}
.lb-topbar{height:65px;background:var(--surface);border-bottom:1.5px solid var(--border);display:flex;align-items:center;padding:0 25px;gap:12px;flex-shrink:0;position:sticky;top:0;z-index:10}
.lb-topbar-logo{font-family:'Rajdhani',sans-serif;font-size:22px;font-weight:700;color:var(--accent);letter-spacing:5px}
.lb-back-btn{display:flex;align-items:center;gap:6px;height:36px;padding:0 14px;background:var(--surface2);border:1.5px solid var(--border);border-radius:var(--r-sm);color:var(--muted);font-size:13px;font-weight:800;cursor:pointer;font-family:inherit;margin-left:auto;transition:all .2s}
.lb-back-btn:hover{background:var(--accent);color:#fff;border-color:var(--accent)}
.lb-refresh-btn{width:36px;height:36px;background:var(--surface2);border:1.5px solid var(--border);border-radius:var(--r-sm);color:var(--muted);font-size:19px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s}
.lb-refresh-btn:hover{background:var(--accent);color:#fff;border-color:var(--accent)}
.lb-refresh-btn.spinning i{animation:spin .6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.lb-page-hero{padding:28px 25px 16px;flex-shrink:0}
.lb-page-hero h1{font-family:'Rajdhani',sans-serif;font-size:34px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:10px}
.lb-page-hero h1 i{color:#f59e0b}
.lb-page-hero p{font-size:13px;font-weight:600;color:var(--muted);margin-top:4px}
.lb-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px;padding:0 25px 40px}
.lb-card{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;transition:box-shadow .2s,transform .2s;animation:fadeUp .4s var(--ease) both}
.lb-card:hover{box-shadow:var(--sh-md);transform:translateY(-3px)}
.lb-card-img{width:100%;height:130px;object-fit:cover;display:block;background:var(--surface2)}
.lb-card-img-placeholder{width:100%;height:130px;background:linear-gradient(135deg,var(--accent-light),var(--surface2));display:flex;align-items:center;justify-content:center}
.lb-card-img-placeholder i{font-size:44px;color:var(--accent);opacity:.35}
.lb-card-body{padding:14px 16px 16px;flex:1;display:flex;flex-direction:column;gap:10px}
.lb-card-hdr{display:flex;align-items:center;gap:8px}
.lb-card-title{font-family:'Rajdhani',sans-serif;font-size:18px;font-weight:700;color:var(--text);flex:1}
.lb-type-pill{font-size:10px;font-weight:800;padding:3px 9px;border-radius:99px;flex-shrink:0}
.lb-type-pill.score{background:var(--accent-light);color:var(--accent)}
.lb-type-pill.time{background:#e0f2fe;color:#0891b2}
.lb-winner{display:flex;align-items:center;gap:10px;padding:10px 12px;background:linear-gradient(135deg,#fffbeb,#fef3c7);border:1.5px solid #f59e0b;border-radius:10px;transition:background .2s}
.lb-winner:hover{background:linear-gradient(90deg,#fffbeb,#fef9e0,#fffbeb);background-size:200% auto}
body.dark .lb-winner{background:linear-gradient(135deg,#2a2510,#251e08)}
body.dark .lb-winner:hover{background:linear-gradient(135deg,#32290f,#2a2007)}
.lb-winner-trophy{font-size:26px;flex-shrink:0}
.lb-winner-info{flex:1;min-width:0}
.lb-winner-name{font-size:14px;font-weight:800;color:var(--text);display:flex;align-items:center;gap:6px;transition:color .15s}
.lb-winner:hover .lb-winner-name{color:var(--accent)}
.lb-winner-sub{font-size:10px;font-weight:600;color:var(--muted);margin-top:2px}
.lb-winner-score{font-family:'Rajdhani',sans-serif;font-size:22px;font-weight:700;color:#d97706;flex-shrink:0}
.lb-winner-score.time{color:#0891b2}
.lb-empty-entry{display:flex;align-items:center;gap:10px;padding:12px;background:var(--surface2);border-radius:10px;color:var(--muted);font-size:13px;font-weight:700}
.lb-empty-entry i{font-size:20px;opacity:.45}
.lb-submit-global{display:inline-flex;align-items:center;gap:7px;height:38px;padding:0 18px;background:var(--accent);color:#fff;border:none;border-radius:var(--r-sm);font-size:13px;font-weight:800;cursor:pointer;font-family:inherit;transition:opacity .2s;margin-top:10px;text-decoration:none}
.lb-submit-global:hover{opacity:.87}
.lb-submit-global:disabled{opacity:.4;cursor:not-allowed}
.lb-you-pill{font-size:9px;font-weight:800;background:var(--accent);color:#fff;padding:1px 6px;border-radius:99px}
.lb-page-loading{display:flex;align-items:center;justify-content:center;padding:80px;color:var(--muted);font-size:14px;font-weight:700;gap:10px;flex-direction:column;grid-column:1/-1}
.lb-spinner{width:32px;height:32px;border:3px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .7s linear infinite}
.lb-page-empty{text-align:center;padding:80px 20px;color:var(--muted);font-size:14px;font-weight:700;grid-column:1/-1}
.lb-page-empty i{font-size:48px;display:block;margin-bottom:12px;opacity:.35}

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVE — TABLET (≤768px)
   ═══════════════════════════════════════════════════════════════ */
@media (max-width:768px){
  /* Topbar */
  .topbar{padding:0 14px;gap:8px;height:58px}
  .tb-logo{font-size:18px;letter-spacing:4px}
  .tb-search{max-width:none;flex:1;min-width:0}
  .tb-search input{font-size:13px;height:36px}
  .icon-btn{width:36px;height:36px;font-size:19px}
  .tb-avatar-btn{width:32px;height:32px}

  /* Hero */
  .page-hero{padding:18px 16px 12px;gap:8px}
  .page-title{font-size:26px}
  .page-sub{display:none}

  /* Category tabs */
  .cat-tabs-outer{padding:0 16px 14px;gap:6px}
  .cat-tab{font-size:12.5px;height:32px;padding:0 11px}
  .cat-scroll-btn{width:28px;height:28px;font-size:18px}

  /* Section wraps */
  .sec-wrap{padding:0 16px 22px}
  .sec-label{font-size:10px;letter-spacing:2.5px}

  /* Game of the Day */
  .gotd{margin:0 16px 22px;min-height:170px}
  .gotd-name{font-size:22px}
  .gotd-desc{display:none}
  .gotd-play{height:38px;padding:0 14px;font-size:13px}
  .gotd-genre{font-size:11px}

  /* Featured carousel */
  .feat-arrow{display:none}
  .feat-carousel{border-radius:var(--r-sm)}
  .rec-card{height:auto;flex-direction:column}
  .rc-thumb{width:100%;height:120px}
  .rc-thumb img{width:100%;height:100%}
  .rc-body{padding:10px 12px}
  .rc-name{font-size:15px}

  /* Game grid */
  #gamebar{grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}

  /* Game page */
  .gp-hdr{padding:12px 16px 8px}
  .gp-title{font-size:22px}
  .gp-desc{font-size:12px}
  .gp-banner{margin:8px 16px}
  .stage{margin:0 16px;border-radius:var(--r-sm)}
  .game-iframe{height:55vw;min-height:280px;max-height:520px}

  /* Ctrl bar */
  .ctrl-bar{padding:0 10px;gap:2px;height:48px}
  .ctrl-logo{display:none}
  .ctrl-sep{margin:0 2px}
  .cbtn{width:32px;height:32px;font-size:17px}
  #ctrlPlaytime{padding:2px 8px 2px 6px;font-size:10px}

  /* Splash modal */
  .sp-ov{padding:12px}
  .sp-img{height:180px}
  .sp-body{padding:14px 16px 20px}
  .sp-title{font-size:20px}
  .sp-meta{gap:14px}

  /* Profile panel — bottom sheet on mobile, fluid sizing handles the rest */
  #profilePanel{padding:58px 0 0;align-items:flex-end;justify-content:center}
  .pp-card{border-radius:20px 20px 0 0;max-height:92vh}

  /* Settings panel */
  #settingsOv{padding:58px 0 0;align-items:flex-end;justify-content:center}
  .st-panel{width:100%;border-radius:20px 20px 0 0;max-height:92vh}

  /* Leaderboard */
  .lb-grid{grid-template-columns:1fr;padding:0 16px 30px;gap:12px}
  .lb-page-hero{padding:20px 16px 12px}
  .lb-page-hero h1{font-size:26px}
  .lb-topbar{padding:0 16px}

  /* History */
  .hp-topbar{padding:0 16px}
  .hp-hero{padding:20px 16px 12px}
  .hp-hero h1{font-size:26px}
  .hp-content{padding:0 16px 30px}
  .hp-stats-bar{grid-template-columns:1fr 1fr 1fr;gap:8px}
  .hp-stat-n{font-size:20px}
  .hp-item{gap:10px;padding:10px 12px}
  .hp-item-thumb{width:44px;height:44px}
  .hp-item-name{font-size:13px}

  /* Toasts */
  .tw{bottom:14px;right:14px;left:14px;align-items:stretch}
  .toast{min-width:unset;max-width:unset;width:100%}

  /* Ambient orbs — reduce on mobile */
  .amb-orb.a{width:200px;height:200px}
  .amb-orb.b{width:160px;height:160px}
  .amb-orb.c{width:130px;height:130px}
}

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVE — MOBILE (≤480px)
   ═══════════════════════════════════════════════════════════════ */
@media (max-width:480px){
  /* Topbar — hide text labels to save space */
  .tb-logo{letter-spacing:3px;font-size:16px}
  .tb-search input{font-size:12px;height:34px;padding:0 32px 0 32px}

  /* Hero */
  .page-title{font-size:22px}

  /* Game grid — 2 columns on small phones */
  #gamebar{grid-template-columns:1fr 1fr;gap:8px}
  .gc>.gc-n{font-size:12px;bottom:22px}
  .gc>.gc-g{font-size:9.5px;bottom:8px}
  .gc>.gc-fav{width:26px;height:26px;font-size:13px}

  /* Game of the Day */
  .gotd{min-height:140px}
  .gotd-name{font-size:18px}
  .gotd-play{height:34px;padding:0 12px;font-size:12px}
  .gotd-crown{font-size:10px;padding:3px 8px}
  .gotd-date{font-size:10px;padding:3px 8px}

  /* Game page iframe */
  .game-iframe{height:60vw;min-height:240px}

  /* Section padding */
  .sec-wrap{padding:0 12px 18px}
  .cat-tabs-outer{padding:0 12px 12px}
  .gotd{margin:0 12px 18px}
  .stage{margin:0 12px}
  .gp-hdr{padding:10px 12px 6px}
  .gp-banner{margin:6px 12px}
  .page-hero{padding:14px 12px 10px}

  /* History stats */
  .hp-stats-bar{grid-template-columns:1fr;gap:6px}
  .hp-content{padding:0 12px 24px}
  .hp-topbar{padding:0 12px}
  .hp-hero{padding:16px 12px 10px}
  .hp-item-play{display:none}

  /* Leaderboard */
  .lb-grid{padding:0 12px 24px}
  .lb-topbar{padding:0 12px}
  .lb-page-hero{padding:16px 12px 10px}

  /* Splash */
  .sp-img{height:150px}
  .sp-title{font-size:18px}
  .sp-meta label{font-size:9px}
  .sp-meta p{font-size:12px}
  .sp-desc{font-size:13px}
  .play-btn{font-size:14px;height:44px}

  /* Settings / profile panels */
  .st-tabs .st-tab span{display:none}
  .pp-stats .pp-stat-l{font-size:8px}

  /* Toasts */
  .toast{min-width:unset}
  .toast-title{font-size:12.5px}
}

/* ═══════════════════════════════════════════════════════════════
   TOUCH SWIPE SUPPORT for featured carousel
   ═══════════════════════════════════════════════════════════════ */
.feat-carousel{touch-action:pan-y;user-select:none}

/* ── ACHIEVEMENTS PAGE ──────────────────────────────────────────────────── */
#achPage{position:fixed;inset:0;z-index:2500;background:var(--bg);overflow-y:auto;display:none;flex-direction:column}
#achPage.open{display:flex}
.ach-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
.ach-card{background:var(--surface);border:1.5px solid var(--border);border-radius:var(--r);padding:16px;display:flex;align-items:center;gap:14px;transition:box-shadow .2s,transform .2s,border-color .2s;animation:fadeUp .3s var(--ease) both}
.ach-card:hover{box-shadow:var(--sh-md);transform:translateY(-2px)}
.ach-card.earned{border-color:var(--accent)}
.ach-card.earned:hover{box-shadow:0 8px 28px var(--accent-glow)}
.ach-icon-wrap{width:52px;height:52px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ach-icon-wrap i{font-size:26px}
.ach-info{flex:1;min-width:0}
.ach-name{font-size:14px;font-weight:800;color:var(--text)}
.ach-desc{font-size:11px;font-weight:600;color:var(--muted);margin-top:2px}
.ach-status{font-size:10px;font-weight:800;margin-top:5px;display:flex;align-items:center;gap:4px}
</style>
</head>
<body>

<div id="loader"><div class="ld-wrap"><div class="ld-trail">FUSION</div><div class="ld-logo">FUSION</div></div></div>
<div id="ambientBg"><div class="amb-orb a"></div><div class="amb-orb b"></div><div class="amb-orb c"></div></div>

<header class="topbar">
  <div class="tb-logo">FUSION</div>
  <div class="tb-search">
    <i class="bx bx-search"></i>
    <input type="text" id="searchbar" placeholder="Search games…" oninput="doSearch()" autocomplete="off">
    <button class="tb-search-clear" id="tbSearchClear" tabindex="-1" title="Clear search" type="button"><i class="bx bx-x"></i></button>
  </div>
  <div class="tb-right">
    <button class="icon-btn" onclick="openLeaderboard()" title="Leaderboard"><i class="bx bx-trophy"></i></button>
    <button class="icon-btn" onclick="openHistoryPage()" title="Play History"><i class="bx bx-history"></i></button>
    <button class="tb-avatar-btn" id="tbAvatarBtn" onclick="toggleProfile()" title="Profile" data-profile-btn>
      <span class="tb-av-fallback" id="tbAvFallback">?</span>
    </button>
    <button class="icon-btn" onclick="openSettings()" title="Settings" data-settings-btn><i class="bx bx-cog"></i></button>
  </div>
</header>

<!-- LEADERBOARD FULL PAGE -->
<section id="lbPage">
  <div class="lb-topbar">
    <div class="lb-topbar-logo">FUSION</div>
    <button class="lb-refresh-btn" id="lbRefreshBtn" onclick="refreshLeaderboard()" title="Refresh"><i class="bx bx-refresh"></i></button>
    <button class="lb-back-btn" onclick="closeLeaderboard()"><i class="bx bx-arrow-back"></i> Back</button>
  </div>
  <div class="lb-page-hero">
    <h1><i class="bx bxs-trophy"></i>Leaderboard</h1>
    <p>Current record holder per game — updated from CDN</p>
    <button class="lb-submit-global" id="lbSubmitBtn" onclick="openScoreSubmit()"><i class="bx bx-send"></i> Submit a Score</button>
  </div>
  <div class="lb-grid" id="lbGrid">
    <div class="lb-page-loading"><div class="lb-spinner"></div>Loading…</div>
  </div>
  <footer class="footer">FUSION ©2026 — All games belong to their respective owners.</footer>
</section>

<!-- HISTORY FULL PAGE -->
<section id="historyPage">
  <div class="hp-topbar">
    <div class="hp-topbar-logo">FUSION</div>
    <button class="hp-clear-btn" onclick="confirmClearHistory()"><i class="bx bx-trash"></i> Clear</button>
    <button class="hp-back-btn" onclick="closeHistoryPage()"><i class="bx bx-arrow-back"></i> Back</button>
  </div>
  <div class="hp-hero">
    <h1><i class="bx bx-history"></i> Play History</h1>
    <p>Every game you've launched, organized by day</p>
  </div>
  <div class="hp-content">
    <div class="hp-stats-bar" id="hpStatsBar"></div>
    <div id="hpTimeline"></div>
  </div>
  <footer class="footer">FUSION ©2026 — All games belong to their respective owners.</footer>
</section>
<!-- ACHIEVEMENTS FULL PAGE -->
<section id="achPage">
  <div class="lb-topbar">
    <div class="lb-topbar-logo">FUSION</div>
    <button class="lb-back-btn" onclick="closeAchievementsPage()"><i class="bx bx-arrow-back"></i> Back</button>
  </div>
  <div class="lb-page-hero">
    <h1><i class="bx bxs-crown"></i> Achievements</h1>
    <p id="achPageSubtitle">Earn badges by playing games and reaching milestones</p>
  </div>
  <div style="padding:0 25px 40px" id="achPageGrid"></div>
  <footer class="footer">FUSION ©2026 — All games belong to their respective owners.</footer>
</section>

<!-- SETTINGS PANEL -->
<div id="settingsOv">
  <div class="st-bg" onclick="closeSettings()"></div>
  <div class="st-panel" data-settings-panel>
    <div class="st-hdr">
      <div class="st-hdr-left">
        <div class="st-hdr-icon"><i class="bx bx-cog"></i></div>
        <div class="st-hdr-title">Settings</div>
        <div class="st-unsaved-dot" id="stUnsaved" title="Unsaved changes"></div>
      </div>
      <button class="st-close" onclick="closeSettings()"><i class="bx bx-x"></i></button>
    </div>
    <div class="st-tabs">
      <button class="st-tab active" id="stTab-appearance" onclick="switchStTab('appearance')"><i class="bx bx-palette"></i> <span>Theme</span></button>
      <button class="st-tab" id="stTab-gameplay" onclick="switchStTab('gameplay')"><i class="bx bx-joystick"></i> <span>Play</span></button>
      <button class="st-tab" id="stTab-notifs" onclick="switchStTab('notifs')"><i class="bx bx-bell"></i> <span>Notifs</span></button>
      <button class="st-tab" id="stTab-privacy" onclick="switchStTab('privacy')"><i class="bx bx-shield"></i> <span>Privacy</span></button>
      <button class="st-tab" id="stTab-more" onclick="switchStTab('more')"><i class="bx bx-dots-horizontal-rounded"></i> <span>More</span></button>
    </div>
    <div class="st-body" id="stBody">
      <div class="st-pane active" id="stPane-appearance">
        <div class="st-group">
          <div class="st-group-label">Theme</div>
          <div class="st-row">
            <div class="st-row-info">
              <div class="st-row-label"><i class="bx bx-moon"></i> Dark Mode</div>
              <div class="st-row-sub">Switch between light and dark interface</div>
            </div>
            <label class="st-toggle"><input type="checkbox" id="stDarkMode" onchange="stMarkUnsaved();applyDark(this.checked)"><div class="st-toggle-track"></div></label>
          </div>
        </div>
        <div class="st-group">
          <div class="st-group-label">Layout</div>
          <div class="st-row">
            <div class="st-row-info">
              <div class="st-row-label"><i class="bx bx-layout"></i> Compact Grid</div>
              <div class="st-row-sub">Show smaller game cards in the grid</div>
            </div>
            <label class="st-toggle"><input type="checkbox" id="stCompactGrid" onchange="stMarkUnsaved();applyCompactGrid(this.checked)"><div class="st-toggle-track"></div></label>
          </div>
          <div class="st-row">
            <div class="st-row-info">
              <div class="st-row-label"><i class="bx bx-wind"></i> Animations</div>
              <div class="st-row-sub">Enable card hover and transition animations</div>
            </div>
            <label class="st-toggle"><input type="checkbox" id="stAnimations" onchange="stMarkUnsaved();applyAnimations(this.checked)"><div class="st-toggle-track"></div></label>
          </div>
        </div>
      </div>
      <div class="st-pane" id="stPane-gameplay">
        <div class="st-group">
          <div class="st-group-label">Playback</div>
          <div class="st-row">
            <div class="st-row-info">
              <div class="st-row-label"><i class="bx bx-play-circle"></i> Autoplay Games</div>
              <div class="st-row-sub">Start the game immediately without clicking Play</div>
            </div>
            <label class="st-toggle"><input type="checkbox" id="stAutoplay" onchange="stMarkUnsaved()"><div class="st-toggle-track"></div></label>
          </div>
          <div class="st-row">
            <div class="st-row-info">
              <div class="st-row-label"><i class="bx bx-fullscreen"></i> Auto Fullscreen</div>
              <div class="st-row-sub">Automatically enter fullscreen when a game starts</div>
            </div>
            <label class="st-toggle"><input type="checkbox" id="stAutoFs" onchange="stMarkUnsaved()"><div class="st-toggle-track"></div></label>
          </div>
          <div class="st-row">
            <div class="st-row-info">
              <div class="st-row-label"><i class="bx bx-exit"></i> Confirm Before Exit</div>
              <div class="st-row-sub">Ask before leaving a game (prevents accidental exits)</div>
            </div>
            <label class="st-toggle"><input type="checkbox" id="stConfirmExit" onchange="stMarkUnsaved()"><div class="st-toggle-track"></div></label>
          </div>
        </div>
