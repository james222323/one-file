.sp-title{font-family:'Rajdhani',sans-serif;font-size:25px;font-weight:700;color:var(--text);margin-bottom:11.3px}
.sp-meta{display:flex;gap:22.5px;flex-wrap:wrap;margin-bottom:11.3px}
.sp-meta label{font-size:10px;font-weight:800;letter-spacing:1.9px;text-transform:uppercase;color:var(--accent);display:block;margin-bottom:2.5px}
.sp-meta p{font-size:13.8px;font-weight:700;color:var(--text)}
.sp-desc{font-size:15px;font-weight:600;color:var(--muted);line-height:1.6;margin-bottom:17.5px}
.sp-actions{display:flex;gap:8.8px}
.play-btn{flex:1;height:50px;background:var(--accent);color:#fff;border:none;border-radius:var(--r-sm);font-size:16.3px;font-weight:800;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7.5px;font-family:inherit;box-shadow:0 5px 17.5px var(--accent-glow);transition:opacity .2s,transform .15s,box-shadow .2s;position:relative;overflow:hidden;animation:playGlow 2.5s ease-in-out infinite}
.play-btn:hover{opacity:1;transform:translateY(-2px);box-shadow:0 10px 30px var(--accent-glow);animation:none}
.play-btn:active{transform:scale(.97)}
.play-btn .ripple-el{position:absolute;border-radius:50%;background:rgba(255,255,255,.3);animation:ripple .6s linear;pointer-events:none}
.fav-btn{width:50px;height:50px;flex-shrink:0;background:var(--surface2);border:none;border-radius:var(--r-sm);color:var(--muted);font-size:21.3px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s,color .2s}
