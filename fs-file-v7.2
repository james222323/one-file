.gc{
  aspect-ratio:4/3;border-radius:var(--r);overflow:hidden;cursor:pointer;position:relative;
  box-shadow:var(--sh-sm);background:var(--surface2);border:2px solid transparent;
  transition:transform .25s var(--ease),box-shadow .25s var(--ease),border-color .2s
}
.gc:hover{transform:translateY(-9px) scale(1.02);box-shadow:0 24px 52px rgba(105,92,254,.3),0 0 0 1.5px var(--accent)}
.gc:active{transform:translateY(-3px) scale(1.005)}
.gc.fav{border-color:var(--accent)}
.gc>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .4s var(--ease)}
.gc:hover>img{transform:scale(1.07)}
.gc>.gc-grad{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.9) 0%,rgba(0,0,0,.1) 55%,transparent 100%);opacity:0;transition:opacity .22s var(--ease);pointer-events:none}
.gc:hover>.gc-grad{opacity:1}
.gc>.gc-play-hint{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(.75);background:rgba(255,255,255,.15);backdrop-filter:blur(10px) saturate(1.8);-webkit-backdrop-filter:blur(10px) saturate(1.8);border:1.5px solid rgba(255,255,255,.3);color:#fff;font-size:12px;font-weight:800;padding:7px 18px;border-radius:99px;display:flex;align-items:center;gap:6px;pointer-events:none;opacity:0;transition:opacity .2s var(--ease),transform .25s var(--ease);white-space:nowrap;letter-spacing:.3px}
.gc>.gc-play-hint i{font-size:14px}
.gc:hover>.gc-play-hint{opacity:1;transform:translate(-50%,-50%) scale(1)}
.gc>.gc-n{position:absolute;bottom:29px;left:11px;right:44px;font-size:14px;font-weight:800;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;opacity:0;transform:translateY(7px);transition:opacity .22s var(--ease),transform .22s var(--ease);pointer-events:none;text-shadow:0 1px 6px rgba(0,0,0,.6)}
.gc:hover>.gc-n{opacity:1;transform:translateY(0)}
.gc>.gc-g{position:absolute;bottom:11px;left:11px;font-size:10.5px;font-weight:700;color:rgba(255,255,255,.7);opacity:0;transform:translateY(5px);transition:opacity .22s .04s var(--ease),transform .22s .04s var(--ease);pointer-events:none}
.gc:hover>.gc-g{opacity:1;transform:translateY(0)}
.gc>.gc-fav{position:absolute;top:8px;right:8px;width:32px;height:32px;border-radius:50%;background:rgba(0,0,0,.38);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);border:1.5px solid rgba(255,255,255,.18);color:#fff;font-size:15px;display:flex;align-items:center;justify-content:center;cursor:pointer;opacity:0;transition:opacity .18s,background .18s,border-color .18s,transform .15s var(--ease)}
.gc:hover>.gc-fav{opacity:1}
.gc>.gc-fav:hover{background:var(--accent);border-color:var(--accent);transform:scale(1.2) rotate(-5deg)}
.gc>.gc-fav:active{transform:scale(.9)}
.gc.fav>.gc-fav{opacity:1;background:var(--accent);border-color:var(--accent)}

/* Always show fav button on touch devices */
@media (hover: none) {
  .gc>.gc-fav{opacity:1}
  .gc>.gc-n{opacity:1;transform:translateY(0)}
  .gc>.gc-g{opacity:1;transform:translateY(0)}
  .gc>.gc-grad{opacity:1}
  .gc>.gc-play-hint{opacity:1;transform:translate(-50%,-50%) scale(1)}
}

.gc-ribbon{
  position:absolute;top:0;left:0;
  width:90px;height:90px;overflow:hidden;
  pointer-events:none;z-index:3;
}
.gc-ribbon-inner{
  position:absolute;
  top:16px;left:-22px;
  width:105px;
  padding:5px 0;
  text-align:center;
  font-size:9.5px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;
  color:#fff;
  transform:rotate(-45deg);
  transform-origin:center;
  display:flex;align-items:center;justify-content:center;gap:4px;
  box-shadow:0 2px 8px rgba(0,0,0,.25);
}
.gc-ribbon-inner i{font-size:10px}
.gc-ribbon-inner.ribbon-new{background:linear-gradient(135deg,#695CFE,#9b8afb)}
.gc-ribbon-inner.ribbon-hot{background:linear-gradient(135deg,#ef4444,#f97316)}
.gc-ribbon-inner.ribbon-updated{background:linear-gradient(135deg,#3b82f6,#06b6d4)}
.gc-ribbon-inner.ribbon-soon{background:linear-gradient(135deg,#10b981,#059669)}
.gc-ribbon-inner.ribbon-experimental{background:linear-gradient(135deg,#f97316,#f59e0b)}
.gc-ribbon-inner::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(90deg,transparent 0%,rgba(255,255,255,.35) 50%,transparent 100%);
  background-size:200% auto;
  animation:badgeShimmer 2.5s linear infinite;
}

