function getEarned(){try{return JSON.parse(localStorage.getItem("fusionEarned")||"[]");}catch{return[];}}
function saveEarned(a){localStorage.setItem("fusionEarned",JSON.stringify(a));}
function getAchievementStats(){
  const playedList=(()=>{try{return JSON.parse(localStorage.getItem("fusionPlayed")||"[]");}catch{return[];}})();
  const played=playedList.length;const favs=getFavs().length;const playtimeSecs=getTotalPlaytime();const xp=getXP();const{streak,best:streakBest}=getStreakDisplay();
  let genres=new Set();if(typeof data!=="undefined")playedList.forEach(id=>{const g=data.find(x=>x.id===id);if(g)g.genre.split(" / ").forEach(gr=>genres.add(gr.trim()));});
  const recent=getRichHistory();let nightOwl=false,earlyBird=false;recent.forEach(r=>{const h=new Date(r.ts).getHours();if(h>=0&&h<4)nightOwl=true;if(h>=4&&h<7)earlyBird=true;});
  let playedGotd=false;if(typeof data!=="undefined"&&data.length){const today=new Date(),seed=today.getFullYear()*10000+(today.getMonth()+1)*100+today.getDate();const gotdId=data[seed%data.length]?.id;if(gotdId)playedGotd=playedList.includes(gotdId);}
  const days=new Set(recent.map(r=>new Date(r.ts).toDateString())).size;
  return{played,favs,genres:genres.size,nightOwl,earlyBird,playedGotd,days,playtimeSecs,xp,streakBest};
}
function checkAchievements(silent=false){
  const s=getSettings();if(!s.trackXp)return getEarned();
  const earned=getEarned();const stats=getAchievementStats();let newlyEarned=[];
  ACHIEVEMENTS.forEach(a=>{if(!earned.includes(a.id)&&a.check(stats)){earned.push(a.id);newlyEarned.push(a);}});
  if(newlyEarned.length){saveEarned(earned);if(!silent)newlyEarned.forEach((a,i)=>setTimeout(()=>showAchievementToast(a),i*900));}
  return earned;
}
function showAchievementToast(a){
  const s=getSettings();if(!s.toastsEnabled||!s.achievementToasts)return;
  const el=document.createElement("div");
  el.className="toast t-xp";
  el.style.cssText+="border-color:"+a.color+";min-width:260px";
  el.innerHTML=
    `<div class="toast-icon" style="background:${a.color}20;width:42px;height:42px;border-radius:12px"><i class="bx ${esc(a.icon)}" style="color:${esc(a.color)};font-size:20px"></i></div>`+
    `<div class="toast-body">`+
      `<div class="toast-title">Achievement Unlocked</div>`+
      `<div class="toast-sub">${esc(a.name)}</div>`+
    `</div>`;
  document.getElementById("tw").appendChild(el);
  setTimeout(()=>{el.classList.add("hiding");setTimeout(()=>el.remove(),250);},(s.toastDuration||4200));
}

