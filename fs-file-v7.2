      const st=document.createElement("div");st.style.cssText=`font-size:10px;margin-top:4px;font-weight:${isEarned?"800":"700"};color:${isEarned?"#22c55e":"var(--muted)"}`;st.textContent=isEarned?"Earned":"Locked";
      tip.appendChild(hdl);tip.appendChild(dsc);tip.appendChild(st);
      const r=wrap.getBoundingClientRect();tip.style.left=Math.min(r.left,window.innerWidth-210)+"px";tip.style.top=(r.bottom+6)+"px";
