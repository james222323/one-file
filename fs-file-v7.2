const REC=8,FEAT_INTERVAL=4000;let featSlides=[],featIdx=0,featTimer=null;
function setupRecs(){
  const n=Math.min(REC,data.length),picks=[],used=new Set();while(picks.length<n){const i=Math.floor(Math.random()*data.length);if(!used.has(i)){used.add(i);picks.push(data[i]);}}
  const track=document.getElementById("featTrack"),dots=document.getElementById("featDots");track.innerHTML="";dots.innerHTML="";featSlides=[];
  picks.forEach(g=>{const slide=document.createElement("div");slide.className="feat-slide";const cardDiv=document.createElement("div");cardDiv.className="rec-card";cardDiv.onclick=()=>openSplash(g.id);const thumb=document.createElement("div");thumb.className="rc-thumb";const tImg=document.createElement("img");tImg.alt=g.name;tImg.loading="lazy";tImg.src=g.img;tImg.onerror=()=>tImg.style.display="none";thumb.appendChild(tImg);const body=document.createElement("div");body.className="rc-body";const badge=document.createElement("span");badge.className="rc-badge";badge.innerHTML='<i class="bx bx-star"></i> Pick';const nm=document.createElement("div");nm.className="rc-name";nm.textContent=g.name;const gn=document.createElement("div");gn.className="rc-genre";gn.textContent=g.genre.replaceAll(" / "," · ");const playBtn=document.createElement("button");playBtn.className="rc-play";playBtn.innerHTML='<i class="bx bx-play-circle"></i> Play';playBtn.onclick=e=>{e.stopPropagation();closeSplash();playGame(g.id);};body.appendChild(badge);body.appendChild(nm);body.appendChild(gn);body.appendChild(playBtn);cardDiv.appendChild(thumb);cardDiv.appendChild(body);slide.appendChild(cardDiv);track.appendChild(slide);featSlides.push(g.id);});
  featSlides.forEach((_,i)=>{const d=document.createElement("button");d.className="feat-dot"+(i===0?" on":"");d.onclick=()=>{featGoTo(i);featRestart();};dots.appendChild(d);});
  featGoTo(0,false);featResume();
  // Touch swipe support for featured carousel
  setupFeatSwipe();
}
function setupFeatSwipe(){
  const carousel=document.getElementById("featCarousel");if(!carousel)return;
  let startX=0,isDragging=false;
  carousel.addEventListener("touchstart",e=>{startX=e.touches[0].clientX;isDragging=true;featPause();},{passive:true});
  carousel.addEventListener("touchend",e=>{
    if(!isDragging)return;isDragging=false;
    const dx=e.changedTouches[0].clientX-startX;
    if(Math.abs(dx)>40){featGoTo(featIdx+(dx<0?1:-1));featRestart();}else{featResume();}
  },{passive:true});
}
function featGoTo(idx,animate=true){featIdx=(idx+featSlides.length)%featSlides.length;const track=document.getElementById("featTrack");if(!animate)track.style.transition="none";track.style.transform=`translateX(-${featIdx*100}%)`;if(!animate)requestAnimationFrame(()=>track.style.transition="");document.querySelectorAll(".feat-dot").forEach((d,i)=>d.classList.toggle("on",i===featIdx));featRestartFill();}
function featNav(dir){featGoTo(featIdx+dir);featRestart();}
function featRestart(){clearInterval(featTimer);featTimer=setInterval(()=>featGoTo(featIdx+1),FEAT_INTERVAL);featRestartFill();}
function featPause(){clearInterval(featTimer);const fill=document.getElementById("featFill");if(fill){fill.style.transition="none";fill.style.width=fill.style.width;}}
function featResume(){featRestart();}
function featRestartFill(){
  const fill=document.getElementById("featFill");if(!fill)return;
  fill.style.transition="none";fill.style.width="0%";
  requestAnimationFrame(()=>requestAnimationFrame(()=>{fill.style.transition=`width ${FEAT_INTERVAL}ms linear`;fill.style.width="100%";}));
}
