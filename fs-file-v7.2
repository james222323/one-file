.sp-close{position:absolute;top:12.5px;right:12.5px;background:rgba(0,0,0,.4);backdrop-filter:blur(5px);border:none;color:#fff;font-size:21.3px;width:32.5px;height:32.5px;border-radius:123.8px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .2s,transform .15s}
