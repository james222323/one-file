.feat-arrow{width:35px;height:35px;flex-shrink:0;background:var(--surface);border:1.3px solid var(--border);border-radius:123.8px;color:var(--muted);font-size:21.3px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s,color .2s,transform .15s}
