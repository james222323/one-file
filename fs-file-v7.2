const HISTORY_KEY="fusionHistory";const HISTORY_MAX=200;
function getRichHistory(){try{return JSON.parse(localStorage.getItem(HISTORY_KEY)||"[]")}catch{return[];}}
function saveRichHistory(arr){localStorage.setItem(HISTORY_KEY,JSON.stringify(arr.slice(0,HISTORY_MAX)));}
function addRichHistory(id){
  const s=getSettings();if(!s.saveHistory)return;
  const arr=getRichHistory();const last=arr[0];if(last&&last.id===id&&Date.now()-last.ts<5000)return;arr.unshift({id,ts:Date.now()});saveRichHistory(arr);
}
function clearRichHistory(){localStorage.removeItem(HISTORY_KEY);}
function confirmClearHistory(){if(confirm("Clear all play history?")){clearRichHistory();renderHistoryPage();_baseToast("History cleared","info","bx-trash");}}
function groupHistoryByDay(arr){const groups={};arr.forEach(item=>{const d=new Date(item.ts).toDateString();if(!groups[d])groups[d]=[];groups[d].push(item);});return groups;}
function formatTime(ts){const d=new Date(ts);return d.toLocaleTimeString("en-US",{hour:"numeric",minute:"2-digit",hour12:true});}
function formatDayLabel(dateStr){const d=new Date(dateStr);const today=new Date().toDateString();const yesterday=new Date(Date.now()-86400000).toDateString();if(dateStr===today)return"Today";if(dateStr===yesterday)return"Yesterday";return d.toLocaleDateString("en-US",{weekday:"long",month:"short",day:"numeric"});}
function openHistoryPage(){renderHistoryPage();document.getElementById("historyPage").classList.add("open");document.getElementById("historyPage").scrollTop=0;}
