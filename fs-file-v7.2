//  XP SYSTEM
// ═══════════════════════════════════════════════════════════════════════════════
const XP_KEY="fusionXP";
function xpForLevel(n){return Math.floor(100*Math.pow(1.12,n-1));}
function xpMinForLevel(n){let t=0;for(let i=1;i<n;i++)t+=xpForLevel(i);return t;}
const XP_REWARDS={play_new:50,play_again:1,fav_game:5,daily_login:100,streak_bonus:20,gotd:75};
function getXP(){return parseInt(localStorage.getItem(XP_KEY)||"0",10);}
function saveXP(v){localStorage.setItem(XP_KEY,String(Math.max(0,v)));}
function getLevelInfo(xp){let level=1;while(xpMinForLevel(level+1)<=xp)level++;const min=xpMinForLevel(level);const max=xpMinForLevel(level+1);return{level,min,max};}
function getNextLevel(xp){const cur=getLevelInfo(xp);const nextMin=xpMinForLevel(cur.level+1);return{level:cur.level+1,min:nextMin,max:xpMinForLevel(cur.level+2)};}
function awardXP(amount,reason){
  const s=getSettings();if(!s.trackXp)return getXP();
  const prev=getXP();const prevLevel=getLevelInfo(prev);const prevRank=getCurrentRank(prevLevel.level);
  const mult=1+(prevLevel.level-1)*0.05;const scaled=Math.round(amount*mult);const newTotal=prev+scaled;saveXP(newTotal);
  const newLevel=getLevelInfo(newTotal);const newRank=getCurrentRank(newLevel.level);
  if(newLevel.level>prevLevel.level){setTimeout(()=>showLevelUpToast(newLevel),800);}
  if(newRank.id!==prevRank.id){setTimeout(()=>showRankToast(newRank),1200);}
  return newTotal;
}
function showLevelUpToast(lvl){
  const s=getSettings();if(!s.toastsEnabled||!s.xpToasts)return;
  const el=document.createElement("div");
  el.className="toast t-xp";
  el.style.minWidth="260px";
  el.innerHTML=
    `<div class="toast-icon" style="width:42px;height:42px;border-radius:12px;font-family:'Rajdhani',sans-serif;font-size:20px;font-weight:700;background:var(--accent);color:#fff;animation:levelUp .5s var(--ease)">${lvl.level}</div>`+
    `<div class="toast-body">`+
      `<div class="toast-title">Level Up!</div>`+
      `<div class="toast-sub">You reached Level ${lvl.level}</div>`+
    `</div>`;
  document.getElementById("tw").appendChild(el);
  setTimeout(()=>{el.classList.add("hiding");setTimeout(()=>el.remove(),250);},s.toastDuration||4500);
}

