.sec-hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:12.5px}
.sec-hdr .sec-label{margin-bottom:0}
.rnd-btn{display:flex;align-items:center;gap:5px;height:32.5px;padding:0 13.8px;background:var(--accent-light);color:var(--accent);border:none;border-radius:123.8px;font-size:12.5px;font-weight:800;cursor:pointer;font-family:inherit;transition:background .2s,color .2s,transform .15s}
