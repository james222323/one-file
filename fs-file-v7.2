#gamebar{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:14px}
.no-res{grid-column:1/-1;text-align:center;padding:55px 25px;color:var(--muted);font-size:16px;font-weight:700}

.sp-ov{position:fixed;inset:0;z-index:1000;display:none;align-items:center;justify-content:center;padding:20px}
.sp-ov.open{display:flex}
.sp-bg{position:absolute;inset:0;background:rgba(0,0,0,.55);backdrop-filter:blur(8.8px)}
.sp-modal{position:relative;z-index:1;background:var(--surface);border-radius:20px;width:100%;max-width:800px;max-height:90vh;overflow-y:auto;box-shadow:var(--sh-lg);animation:pop .2s var(--ease) both}
.sp-img{width:100%;height:237.5px;object-fit:cover;display:block;background:var(--surface2);border-radius:20px 20px 0 0}
