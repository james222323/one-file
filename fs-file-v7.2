      const tip=_getAchTip();tip.innerHTML="";
      const hdl=document.createElement("div");hdl.style.cssText=`font-weight:800;margin-bottom:3px;color:${isEarned?a.color:"var(--text)"}`;hdl.textContent=a.name;
