function makeTab(key,label,icon,count){const btn=document.createElement("button");btn.className="cat-tab"+(key===activeCategory?" active":"");btn.dataset.key=key;btn.innerHTML=`<i class="bx ${esc(icon)}"></i>${esc(label)}<span class="cat-count">${count}</span>`;btn.onclick=()=>selectCategory(key);return btn;}
