    else{const ph=document.createElement("div");ph.className="lb-card-img-placeholder";ph.innerHTML='<i class="bx bx-joystick"></i>';card.appendChild(ph);}
    const body=document.createElement("div");body.className="lb-card-body";const hdr=document.createElement("div");hdr.className="lb-card-hdr";const title=document.createElement("div");title.className="lb-card-title";title.textContent=game.name||"Unknown";const pill=document.createElement("span");pill.className="lb-type-pill "+(isTime?"time":"score");pill.textContent=isTime?"Time":"Score";hdr.appendChild(title);hdr.appendChild(pill);body.appendChild(hdr);
    if(e&&e.name){const isMe=myName&&e.name.toLowerCase().trim()===myName;const winner=document.createElement("div");winner.className="lb-winner";const info=document.createElement("div");info.className="lb-winner-info";const nameRow=document.createElement("div");nameRow.className="lb-winner-name";nameRow.textContent=e.name;if(isMe){const yp=document.createElement("span");yp.className="lb-you-pill";yp.textContent="YOU";nameRow.appendChild(yp);}info.appendChild(nameRow);if(e.note||e.date){const sub=document.createElement("div");sub.className="lb-winner-sub";sub.textContent=[e.note,e.date].filter(Boolean).join(" · ");info.appendChild(sub);}const scoreEl=document.createElement("div");scoreEl.className="lb-winner-score"+(isTime?" time":"");scoreEl.textContent=(e.display||e.score)+unit;winner.innerHTML='<div class="lb-winner-trophy"><i class="bx bxs-trophy" style="font-size:24px;color:#f59e0b"></i></div>';winner.appendChild(info);winner.appendChild(scoreEl);body.appendChild(winner);}
    else{const empty=document.createElement("div");empty.className="lb-empty-entry";empty.innerHTML='<i class="bx bx-medal"></i>';const emptyTxt=document.createElement("span");emptyTxt.textContent="No record yet — be the first!";empty.appendChild(emptyTxt);body.appendChild(empty);}
    card.appendChild(body);grid.appendChild(card);
  });
}
function refreshLeaderboard(){const btn=document.getElementById("lbRefreshBtn");if(btn)btn.classList.add("spinning");lbData=null;loadLeaderboard();setTimeout(()=>{if(btn)btn.classList.remove("spinning");},1200);}

// ── ACHIEVEMENTS PAGE ────────────────────────────────────────────────────
function openAchievementsPage(){
  const earned = new Set(checkAchievements(true));
  const subtitle = document.getElementById("achPageSubtitle");
  subtitle.textContent = earned.size + " / " + ACHIEVEMENTS.length + " earned";
  const grid = document.getElementById("achPageGrid");
  grid.innerHTML = '<div class="ach-grid" id="achInnerGrid"></div>';
  const inner = document.getElementById("achInnerGrid");
  const sorted = [...ACHIEVEMENTS.filter(a=>earned.has(a.id)), ...ACHIEVEMENTS.filter(a=>!earned.has(a.id))];
  sorted.forEach((a, i) => {
    const isEarned = earned.has(a.id);
    const card = document.createElement("div");
    card.className = "ach-card" + (isEarned ? " earned" : "");
    card.style.animationDelay = (i * 30) + "ms";
    card.innerHTML = `
      <div class="ach-icon-wrap" style="background:${isEarned ? a.color + '22' : 'var(--surface2)'};${isEarned ? 'border:1.5px solid '+a.color+'55' : ''}">
        <i class="bx ${a.icon}" style="color:${isEarned ? a.color : 'var(--muted)'}"></i>
      </div>
      <div class="ach-info">
        <div class="ach-name" style="${isEarned ? 'color:'+a.color : ''}">${esc(a.name)}</div>
        <div class="ach-desc">${esc(a.desc)}</div>
        <div class="ach-status" style="color:${isEarned ? '#22c55e' : 'var(--muted)'}">
          <i class="bx ${isEarned ? 'bx-check-circle' : 'bx-lock-alt'}"></i>
          ${isEarned ? 'Earned' : 'Locked'}
        </div>
      </div>`;
    inner.appendChild(card);
  });
  document.getElementById("achPage").classList.add("open");
  document.getElementById("achPage").scrollTop = 0;
}

function closeAchievementsPage(){
  document.getElementById("achPage").classList.remove("open");
}
document.addEventListener('dragstart', e => { if (e.target.tagName === 'IMG') e.preventDefault(); });
</script>
