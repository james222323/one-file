<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FUSION — Games</title>
<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#F0F1F8;--surface:#fff;--surface2:#F4F5FB;
  --accent:#695CFE;--accent-light:#EDEAFF;--accent-glow:rgba(105,92,254,.2);
  --text:#2e2f3e;--muted:#9395a5;--border:rgba(0,0,0,.07);
  --sh-sm:0 2.5px 10px rgba(0,0,0,.05);--sh-md:0 10px 30px rgba(0,0,0,.10);--sh-lg:0 25px 62.5px rgba(105,92,254,.18);
  --r:15px;--r-sm:10px;--ease:cubic-bezier(.4,0,.2,1)
}
body.dark{
  --bg:#0f1012;--surface:#18191e;--surface2:#22232a;
  --accent:#7b6fff;--accent-light:#1a1830;--accent-glow:rgba(123,111,255,.18);
  --text:#e2e3ec;--muted:#5c5e72;--border:rgba(255,255,255,.06);
  --sh-sm:0 2.5px 10px rgba(0,0,0,.4);--sh-md:0 10px 30px rgba(0,0,0,.5);--sh-lg:0 25px 62.5px rgba(0,0,0,.6)
}
html{scroll-behavior:smooth}
body{min-height:100vh;background:var(--bg);font-family:'Nunito',sans-serif;color:var(--text);transition:background .3s,color .3s;overflow-x:hidden}
::selection{background:var(--accent);color:#fff}
::-webkit-scrollbar{width:5px}::-webkit-scrollbar-thumb{background:var(--border);border-radius:123.8px}

/* ── LOADER ───────────────────────────────────────────────────────────────── */
#loader{
  position:fixed;inset:0;z-index:9999;
  background:#0d0820;
  display:flex;align-items:center;justify-content:center;
  transition:opacity .45s ease;
  will-change:opacity;
}
#loader.gone{opacity:0;pointer-events:none}
.ld-wrap{
  position:relative;
  display:flex;align-items:center;justify-content:center;
  will-change:transform;
}
.ld-logo{
  font-family:'Rajdhani',sans-serif;
  font-size:58px;font-weight:700;letter-spacing:12px;
  position:relative;z-index:1;
  background:linear-gradient(135deg,#a78bfa 0%,#695CFE 45%,#c4b5fd 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  text-shadow:0 0 40px rgba(105,92,254,.7),0 0 80px rgba(105,92,254,.3);
  animation:fusionZoom 1s cubic-bezier(.18,0,.28,1) forwards;
  will-change:transform,opacity;
}
.ld-trail{
  position:absolute;inset:0;
  font-family:'Rajdhani',sans-serif;
  font-size:58px;font-weight:700;letter-spacing:12px;
  color:rgba(105,92,254,.28);
  white-space:nowrap;
  animation:fusionTrail 1s cubic-bezier(.18,0,.28,1) forwards;
  will-change:transform,opacity;
  pointer-events:none;
  user-select:none;
}
@keyframes fusionZoom{
  0%  {transform:scale(1);opacity:1}
  60% {transform:scale(6);opacity:1}
  85% {transform:scale(14);opacity:.3}
  100%{transform:scale(20);opacity:0}
}
@keyframes fusionTrail{
  0%  {transform:scale(.92);opacity:.4}
  50% {transform:scale(4);opacity:.15}
  100%{transform:scale(16);opacity:0}
}

@keyframes fadeUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes scaleIn{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
@keyframes slideInLeft{from{opacity:0;transform:translateX(-18px)}to{opacity:1;transform:translateX(0)}}
@keyframes slideInRight{from{opacity:0;transform:translateX(18px)}to{opacity:1;transform:translateX(0)}}
@keyframes shimmer{0%{background-position:-200% center}100%{background-position:200% center}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.7;transform:scale(1.08)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
@keyframes spin360{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
@keyframes ripple{0%{transform:scale(0);opacity:.5}100%{transform:scale(4);opacity:0}}
@keyframes bounceIn{0%{opacity:0;transform:scale(.6)}60%{transform:scale(1.08)}80%{transform:scale(.96)}100%{opacity:1;transform:scale(1)}}
@keyframes gradientShift{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
@keyframes cardGlow{0%,100%{box-shadow:var(--sh-sm)}50%{box-shadow:0 0 20px var(--accent-glow),var(--sh-md)}}
@keyframes skeletonPulse{0%,100%{opacity:.5}50%{opacity:1}}
@keyframes scanline{0%{transform:translateY(-100%)}100%{transform:translateY(100vh)}}
@keyframes logoShimmer{0%{background-position:-200% center}100%{background-position:200% center}}
@keyframes popBounce{0%{transform:scale(.88);opacity:0}65%{transform:scale(1.04)}85%{transform:scale(.98)}100%{transform:scale(1);opacity:1}}
@keyframes xpFill{from{width:var(--xp-from)}to{width:var(--xp-to)}}
@keyframes levelUp{0%{transform:scale(1)}30%{transform:scale(1.3) rotate(-5deg)}60%{transform:scale(1.15) rotate(3deg)}100%{transform:scale(1) rotate(0deg)}}
@keyframes streakPop{0%{transform:scale(.8);opacity:0}70%{transform:scale(1.1)}100%{transform:scale(1);opacity:1}}
@keyframes colorSpin{from{filter:hue-rotate(0deg)}to{filter:hue-rotate(360deg)}}
@keyframes ptPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.55;transform:scale(1.3)}}
@keyframes unsavedPulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(1.5)}}
@keyframes playGlow{0%,100%{box-shadow:0 5px 17.5px var(--accent-glow),0 0 0 0 var(--accent-glow)}50%{box-shadow:0 5px 17.5px var(--accent-glow),0 0 0 8px rgba(105,92,254,0)}}
@keyframes tabUnderlineSweep{from{transform:scaleX(0);transform-origin:left}to{transform:scaleX(1);transform-origin:left}}
@keyframes winnerShimmer{0%{background-position:-200% center}100%{background-position:200% center}}
@keyframes xpBarFill{from{width:0%}to{width:var(--xp-pct,0%)}}
@keyframes badgeShimmer{0%{background-position:-200% center}100%{background-position:200% center}}
@keyframes toastIn{from{opacity:0;transform:translateX(110%) scale(.92)}to{opacity:1;transform:translateX(0) scale(1)}}
@keyframes toastOut{from{opacity:1;transform:translateX(0) scale(1)}to{opacity:0;transform:translateX(110%) scale(.92)}}

.pt-live-dot{width:7px;height:7px;border-radius:50%;background:#22c55e;display:inline-block;flex-shrink:0;animation:ptPulse 1.4s ease-in-out infinite}

body.ready .page-hero{animation:fadeUp .5s var(--ease) both;animation-delay:.05s}
body.ready .page-title{animation:slideInLeft .5s var(--ease) both;animation-delay:.1s}
body.ready .pill{animation:fadeIn .5s both;animation-delay:.15s}
body.ready .page-sub{animation:fadeIn .5s both;animation-delay:.2s}
body.ready .cat-tabs-outer{animation:fadeUp .5s var(--ease) both;animation-delay:.2s}
body.ready #gotdWrap{animation:fadeUp .55s var(--ease) both;animation-delay:.28s}
body.ready #featWrap{animation:fadeUp .55s var(--ease) both;animation-delay:.34s}
.page-hero,.page-title,.pill,.page-sub,.cat-tabs-outer,#gotdWrap,#featWrap{opacity:0}
body.ready .page-hero,body.ready .page-title,body.ready .pill,body.ready .page-sub,body.ready .cat-tabs-outer,body.ready #gotdWrap,body.ready #featWrap{opacity:1}

.tb-logo{
  font-family:'Rajdhani',sans-serif;font-size:22.5px;font-weight:700;letter-spacing:5px;white-space:nowrap;
  background:linear-gradient(90deg,var(--accent) 25%,#a78bfa 50%,var(--accent) 75%);
  background-size:200% auto;
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
  animation:logoShimmer 2s ease .3s 1 forwards, fadeIn .3s both;
}

.dd.open{animation:fadeUp .15s var(--ease) both}
.cat-tab{animation:fadeIn .3s both}
.reveal{transition:opacity .4s var(--ease),transform .4s var(--ease)}
.reveal.visible{opacity:1;transform:translateY(0)}
.gotd-crown{animation:float 3s ease-in-out infinite}

.tw{position:fixed;bottom:20px;right:20px;z-index:9999;display:flex;flex-direction:column;gap:8px;pointer-events:none;align-items:flex-end}
.toast{
  pointer-events:auto;
  display:flex;align-items:center;gap:12px;
  padding:12px 16px;
  background:var(--surface);
  border:1.5px solid var(--border);
  border-radius:14px;
  box-shadow:0 8px 32px rgba(0,0,0,.14),0 2px 8px rgba(0,0,0,.08);
  font-size:13.5px;font-weight:700;color:var(--text);
  min-width:220px;max-width:320px;
  position:relative;overflow:hidden;
  animation:toastIn .32s cubic-bezier(.34,1.56,.64,1) both;
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
}
body.dark .toast{background:rgba(34,35,42,.95);border-color:rgba(255,255,255,.09);}
.toast::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3.5px;background:var(--accent);border-radius:14px 0 0 14px}
.toast-icon{width:32px;height:32px;border-radius:9px;background:var(--accent-light);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.toast-icon i{color:var(--accent);font-size:17px}
.toast-body{flex:1;min-width:0}
.toast-title{font-size:13.5px;font-weight:800;color:var(--text);line-height:1.2}
.toast-sub{font-size:11px;font-weight:600;color:var(--muted);margin-top:2px}
.toast.hiding{animation:toastOut .22s cubic-bezier(.4,0,.2,1) forwards}
.toast.t-fav::before{background:#f43f5e}
.toast.t-fav .toast-icon{background:#fff1f2}
.toast.t-fav .toast-icon i{color:#f43f5e}
.toast.t-success::before{background:#22c55e}
.toast.t-success .toast-icon{background:#f0fdf4}
.toast.t-success .toast-icon i{color:#22c55e}
.toast.t-warn::before{background:#f59e0b}
.toast.t-warn .toast-icon{background:#fffbeb}
.toast.t-warn .toast-icon i{color:#f59e0b}
.toast.t-error::before{background:#ef4444}
.toast.t-error .toast-icon{background:#fef2f2}
.toast.t-error .toast-icon i{color:#ef4444}
.toast.t-xp::before{background:var(--accent)}
.toast.t-xp .toast-icon{background:var(--accent-light)}
.toast.t-xp .toast-icon i{color:var(--accent)}

.cbtn{transition:background .2s,transform .12s}
.cbtn:hover{transform:scale(1.15)}
.cbtn:active{transform:scale(.9)}
.play-big{transition:transform .2s,box-shadow .2s}
.play-cover:hover .play-big{transform:scale(1.12);box-shadow:0 0 0 22px var(--accent-glow)}

#ambientBg{position:fixed;inset:0;pointer-events:none;z-index:0;overflow:hidden}
.amb-orb{position:absolute;border-radius:50%;filter:blur(80px);opacity:.07;animation:float 8s ease-in-out infinite}
body.dark .amb-orb{opacity:.12}
.amb-orb.a{width:400px;height:400px;background:var(--accent);top:-10%;left:-10%;animation-duration:9s}
.amb-orb.b{width:300px;height:300px;background:#a78bfa;top:40%;right:-8%;animation-duration:11s;animation-delay:-4s}
.amb-orb.c{width:250px;height:250px;background:#f59e0b;bottom:-5%;left:35%;animation-duration:13s;animation-delay:-7s}

.topbar{position:sticky;top:0;z-index:300;height:65px;background:var(--surface);border-bottom:1.3px solid var(--border);display:flex;align-items:center;padding:0 25px;gap:12.5px;transition:background .3s,box-shadow .3s}
.topbar.scrolled{box-shadow:0 4px 24px rgba(0,0,0,.1);border-bottom-color:transparent}
body.dark .topbar.scrolled{box-shadow:0 4px 24px rgba(0,0,0,.45)}
.tb-search{flex:1;max-width:475px;position:relative}
.tb-search i.bx-search{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:19px;pointer-events:none;transition:color .2s}
.tb-search input{width:100%;height:40px;background:var(--surface2);border:1.9px solid transparent;border-radius:99px;padding:0 38px 0 38px;font-size:14px;font-weight:600;color:var(--text);outline:none;font-family:inherit;transition:border-color .2s,background .2s,box-shadow .2s}
.tb-search input::placeholder{color:var(--muted)}
.tb-search input:focus{border-color:var(--accent);background:var(--surface);box-shadow:0 0 0 3px var(--accent-glow);border-radius:var(--r-sm)}
.tb-search:focus-within i.bx-search{color:var(--accent)}
.tb-search-clear{
  position:absolute;right:10px;top:50%;transform:translateY(-50%);
  width:22px;height:22px;border-radius:50%;
  background:var(--muted);border:none;color:#fff;
  font-size:14px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:background .15s,opacity .15s,transform .15s;
  padding:0;line-height:1;opacity:0;pointer-events:none;
  flex-shrink:0;
}
.tb-search-clear.show{opacity:1;pointer-events:auto}
.tb-search-clear:hover{background:var(--accent);transform:translateY(-50%) scale(1.1)}
.tb-right{display:flex;gap:5px;margin-left:auto;align-items:center}
.icon-btn{width:40px;height:40px;background:transparent;border:none;border-radius:var(--r-sm);color:var(--muted);font-size:21px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .18s,color .18s,transform .15s;position:relative}
.icon-btn:hover{background:var(--accent-light);color:var(--accent);transform:scale(1.1)}
.icon-btn:active{transform:scale(.9);background:var(--accent);color:#fff}
.icon-btn .tb-dot{position:absolute;top:7px;right:7px;width:7px;height:7px;border-radius:50%;background:#ef4444;border:1.5px solid var(--surface);pointer-events:none}
.tb-avatar-btn{width:36px;height:36px;border-radius:50%;border:2px solid var(--border);background:var(--surface2);overflow:hidden;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:border-color .2s,box-shadow .2s,transform .15s;padding:0;flex-shrink:0}
.tb-avatar-btn:hover{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-glow);transform:scale(1.08)}
.tb-avatar-btn img{width:100%;height:100%;object-fit:cover;display:block}
.tb-avatar-btn .tb-av-fallback{font-size:15px;font-weight:800;color:var(--accent);font-family:'Rajdhani',sans-serif;line-height:1}

.dd{position:absolute;top:calc(100% + 7.5px);right:0;background:var(--surface);border:1.3px solid var(--border);border-radius:var(--r);box-shadow:var(--sh-md);min-width:212.5px;overflow:hidden;display:none;z-index:600}
.dd.open{display:block}
.dd button{display:flex;align-items:center;gap:11.3px;width:100%;padding:12.5px 17.5px;background:transparent;border:none;color:var(--text);font-size:16.3px;font-weight:700;cursor:pointer;font-family:inherit;transition:background .15s}
.dd button:hover{background:var(--accent);color:#fff}

#profilePanel{position:fixed;inset:0;z-index:2000;display:none;align-items:flex-start;justify-content:flex-end;padding:75px 17.5px 17.5px;pointer-events:none}
#profilePanel.open{display:flex}
.pp-bg{position:fixed;inset:0;background:rgba(0,0,0,.3);backdrop-filter:blur(5px);pointer-events:auto;animation:ppBgIn .2s var(--ease)}
@keyframes ppBgIn{from{opacity:0}to{opacity:1}}
.pp-card{
  position:relative;z-index:1;
  /* fluid width: 375px on desktop, full-width on tiny screens */
  width:min(375px, 100vw);
  max-height:min(calc(100vh - 95px), 92vh);
  background:var(--surface);border:1.3px solid var(--border);border-radius:20px;
  box-shadow:var(--sh-lg);overflow:hidden;display:flex;flex-direction:column;
  pointer-events:auto;animation:ppIn .22s var(--ease) both;
  /* fluid font base so every rem/px inside scales with viewport */
  font-size:clamp(13px, 3.5vw, 15px);
}
@keyframes ppIn{from{opacity:0;transform:translateY(-10px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
.pp-banner{height:90px;flex-shrink:0;position:relative;overflow:hidden;background:linear-gradient(135deg,#695CFE 0%,#a78bfa 40%,#f59e0b 100%);background-size:200% 200%;animation:gradientShift 6s ease infinite}
.pp-banner::after{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")}
.pp-banner-close{
  position:absolute;top:10px;right:10px;
  width:30px;height:30px;border-radius:50%;
  background:rgba(0,0,0,.25);border:1.5px solid rgba(255,255,255,.25);
  color:#fff;font-size:18px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:background .15s,transform .15s;
  z-index:10;
}
.pp-banner-close:hover{background:rgba(0,0,0,.55);transform:scale(1.1) rotate(90deg)}
.pp-av-wrap{padding:0 20px;display:flex;align-items:flex-end;justify-content:space-between;margin-top:-32.5px;position:relative;z-index:1;flex-shrink:0}
/* left cluster: avatar + streak flame side-by-side */
.pp-av-left{display:flex;align-items:flex-end;gap:8px}
.pp-avatar{width:clamp(56px,15vw,65px);height:clamp(56px,15vw,65px);border-radius:50%;border:3.8px solid var(--surface);background:var(--surface2);overflow:hidden;flex-shrink:0;cursor:pointer;position:relative}
.pp-avatar:hover .pp-av-overlay{opacity:1}
.pp-avatar img{width:100%;height:100%;object-fit:cover;display:block}
.pp-av-fallback{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-family:'Rajdhani',sans-serif;font-size:25px;font-weight:700;color:var(--accent)}
.pp-av-overlay{position:absolute;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .2s;border-radius:50%}
.pp-av-overlay i{color:#fff;font-size:18.8px}
.pp-edit-btn{height:30px;padding:0 13.8px;background:var(--accent-light);color:var(--accent);border:none;border-radius:123.8px;font-size:12.5px;font-weight:800;cursor:pointer;font-family:inherit;margin-bottom:2.5px;transition:background .2s,color .2s,transform .15s}
.pp-edit-btn:hover{background:var(--accent);color:#fff;transform:scale(1.05)}
.pp-info{padding:8.8px 20px 0;flex-shrink:0}
.pp-name{font-family:'Rajdhani',sans-serif;font-size:21.3px;font-weight:700;color:var(--text);line-height:1.1}
.pp-handle{font-size:12.5px;font-weight:700;color:var(--muted);margin-top:1.3px}
.pp-bio{font-size:13.8px;font-weight:600;color:var(--muted);margin-top:5px;line-height:1.5;cursor:pointer;border-radius:6.3px;padding:2.5px 3.8px;margin-left:-3.8px;transition:background .15s}
.pp-bio:hover{background:var(--surface2)}
.pp-xp-row{margin:10px 20px 0;flex-shrink:0}
.pp-xp-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px}
.pp-xp-level{font-family:'Rajdhani',sans-serif;font-size:13px;font-weight:700;color:var(--accent);display:flex;align-items:center;gap:6px}
.pp-xp-level-badge{width:24px;height:24px;border-radius:50%;background:var(--accent);color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;font-family:'Rajdhani',sans-serif;flex-shrink:0;transition:transform .3s}
.pp-xp-level-badge.pop{animation:levelUp .5s var(--ease)}
.pp-xp-next{font-size:10px;font-weight:700;color:var(--muted)}
.pp-xp-bar-outer{height:6px;background:var(--border);border-radius:99px;overflow:hidden}
.pp-xp-bar-fill{height:100%;background:linear-gradient(90deg,var(--accent),#a78bfa);border-radius:99px;width:0%;transition:width .7s cubic-bezier(.4,0,.2,1)}
/* ── STREAK FLAME BADGE (next to avatar) ─────────────────────────────────── */
.pp-streak-badge{
  position:relative;
  width:clamp(38px,10vw,46px);
  height:clamp(46px,12vw,56px);
  flex-shrink:0;
  cursor:default;
  /* nudge up a bit so it "sits" next to the avatar bottom edge */
  margin-bottom:2px;
  filter:drop-shadow(0 3px 8px rgba(249,115,22,.45));
  animation:streakPop .4s var(--ease);
  transition:filter .2s,transform .2s;
}
.pp-streak-badge:hover{
  filter:drop-shadow(0 4px 14px rgba(249,115,22,.7));
  transform:scale(1.08) translateY(-2px);
}
.pp-streak-badge svg{width:100%;height:100%;display:block}
/* number rendered via JS into this element */
.pp-streak-badge-num{
  position:absolute;
  inset:0;
  display:flex;align-items:center;justify-content:center;
  /* shift down a touch inside the flame body */
  padding-top:30%;
  font-family:'Rajdhani',sans-serif;
  font-size:clamp(11px,3vw,14px);
  font-weight:700;
  color:#fff;
  text-shadow:0 1px 3px rgba(0,0,0,.4);
  pointer-events:none;
  line-height:1;
  letter-spacing:-.5px;
}
/* tooltip on hover */
.pp-streak-badge[title]:hover::after{
  content:attr(data-tip);
  position:absolute;
  bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);
  background:rgba(0,0,0,.75);color:#fff;
  font-size:10px;font-weight:700;font-family:'Nunito',sans-serif;
  white-space:nowrap;padding:4px 8px;border-radius:6px;
  pointer-events:none;
}

