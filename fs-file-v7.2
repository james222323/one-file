const TOAST_CLASS_MAP={success:"t-success",info:"t-xp",warn:"t-warn",error:"t-error",fav:"t-fav",xp:"t-xp",achievement:"t-xp"};

function _baseToast(title,type,iconOverride,subtitle){
  type=type||"info";
  const iconCls=iconOverride||TOAST_ICON_MAP[type]||"bx-info-circle";
  const typeCls=TOAST_CLASS_MAP[type]||"";
  const dur=getSettings().toastDuration||2600;

  const el=document.createElement("div");
  el.className="toast "+typeCls;
  el.innerHTML=
    `<div class="toast-icon"><i class="bx ${esc(iconCls)}"></i></div>`+
    `<div class="toast-body">`+
      `<div class="toast-title">${esc(title)}</div>`+
      (subtitle?`<div class="toast-sub">${esc(subtitle)}</div>`:"")+
    `</div>`;

  document.getElementById("tw").appendChild(el);

  setTimeout(()=>{
    el.classList.add("hiding");
    setTimeout(()=>el.remove(),250);
  },dur);
}

