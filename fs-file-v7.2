const PT_KEY="fusionPlaytime";
function getTotalPlaytime(){return parseInt(localStorage.getItem(PT_KEY)||"0",10);}
function saveTotalPlaytime(secs){localStorage.setItem(PT_KEY,String(Math.max(0,Math.round(secs))));}
function formatPlaytime(secs){if(secs<60)return secs+"s";const m=Math.floor(secs/60);if(m<60)return m+"m";const h=Math.floor(m/60),rm=m%60;if(h<10)return rm>0?h+"h "+rm+"m":h+"h";return h+"h";}
function formatLive(secs){const h=Math.floor(secs/3600);const m=Math.floor((secs%3600)/60);const s=secs%60;if(h>0)return h+":"+String(m).padStart(2,"0")+":"+String(s).padStart(2,"0");return String(m).padStart(2,"0")+":"+String(s).padStart(2,"0");}
let _ptActive=false,_ptStartTS=null,_ptSession=0,_ptTick=null;
function ptStart(){const s=getSettings();if(!s.trackPlaytime)return;if(_ptActive)return;_ptActive=true;_ptStartTS=Date.now();_ptTick=setInterval(_ptOnTick,1000);}
function ptPause(){if(!_ptActive)return;_ptActive=false;clearInterval(_ptTick);_ptTick=null;_ptFlush();}
function ptReset(){ptPause();_ptSession=0;_updateCtrlBar(0);}
function _ptFlush(){if(_ptStartTS===null)return;const elapsed=Math.floor((Date.now()-_ptStartTS)/1000);_ptSession+=elapsed;_ptStartTS=null;saveTotalPlaytime(getTotalPlaytime()+elapsed);}
function _ptOnTick(){if(!_ptActive||_ptStartTS===null)return;const liveElapsed=Math.floor((Date.now()-_ptStartTS)/1000);_updateCtrlBar(_ptSession+liveElapsed);}
function _updateCtrlBar(secs){const el=document.getElementById("ctrlPtText");if(el)el.textContent=formatLive(secs);}
