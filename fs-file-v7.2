const STREAK_KEY="fusionStreak";
function getStreakData(){try{return JSON.parse(localStorage.getItem(STREAK_KEY)||"{}")}catch{return{}}}
function saveStreakData(d){localStorage.setItem(STREAK_KEY,JSON.stringify(d));}
function todayStr(){return new Date().toDateString();}
function yesterdayStr(){const d=new Date();d.setDate(d.getDate()-1);return d.toDateString();}
function checkAndUpdateStreak(){
  const d=getStreakData();const today=todayStr();const yesterday=yesterdayStr();if(d.lastDay===today)return d;
  let streak=d.streak||0;let best=d.best||0;
  if(d.lastDay===yesterday){streak++;}else if(!d.lastDay){streak=1;}else{streak=1;}
  best=Math.max(best,streak);const updated={streak,best,lastDay:today};saveStreakData(updated);
  const bonusXP=XP_REWARDS.daily_login+(streak-1)*XP_REWARDS.streak_bonus;awardXP(bonusXP,streak>1?"Day "+streak+" streak!":"Daily login bonus");return updated;
}
function getStreakDisplay(){const d=getStreakData();return{streak:d.streak||0,best:d.best||0,lastDay:d.lastDay||null};}

